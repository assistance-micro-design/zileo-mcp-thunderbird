# Zileo MCP — Thunderbird: environment configuration template.
# Copy to .env and adjust: cp .env.example .env
# Every variable is OPTIONAL and has a safe default — no secrets are required.

# WebSocket bridge port (Thunderbird extension <-> bridge container).
# Default: 9876
THUNDERBIRD_PORT=9876

# Logging level: debug | info | warn | error.
# Default: info
LOG_LEVEL=info
