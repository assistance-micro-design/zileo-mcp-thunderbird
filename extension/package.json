{
  "name": "@thunderbird-mcp/extension",
  "version": "1.3.1",
  "description": "Thunderbird WebExtension for Thunderbird MCP",
  "private": true,
  "scripts": {
    "package": "rm -f ../releases/thunderbird-mcp-${npm_package_version}.xpi && mkdir -p ../releases && zip -qr ../releases/thunderbird-mcp-${npm_package_version}.xpi . -x 'package.json' -x '*.xpi' -x '.*' -x 'node_modules/*' && echo \"Packaged releases/thunderbird-mcp-${npm_package_version}.xpi\""
  }
}
