{
  "manifest_version": 3,
  "name": "Thunderbird MCP Server",
  "description": "Model Context Protocol server for Thunderbird - enables AI assistants to interact with emails, contacts, and calendars",
  "version": "1.1.6",
  "author": "Assistance Micro Design",
  "homepage_url": "https://github.com/assistance-micro-design/thunderbird-mcp",

  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-mcp@assistance-micro-design.com",
      "strict_min_version": "128.0"
    }
  },

  "background": {
    "page": "background.html"
  },

  "permissions": [
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "accountsRead",
    "accountsFolders",
    "addressBooks",
    "alarms"
  ],

  "host_permissions": [
    "ws://localhost:9876/*",
    "http://localhost:9876/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://localhost:9876"
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "default_locale": "en",

  "experiment_apis": {
    "calendar_calendars": {
      "schema": "experiments/calendar/schema/calendar-calendars.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-calendars.js",
        "paths": [["calendar", "calendars"]]
      }
    },
    "calendar_items": {
      "schema": "experiments/calendar/schema/calendar-items.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-items.js",
        "paths": [["calendar", "items"]]
      }
    },
    "calendar_timezones": {
      "schema": "experiments/calendar/schema/calendar-timezones.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-timezones.js",
        "paths": [["calendar", "timezones"]]
      },
      "child": {
        "scopes": ["addon_child"],
        "script": "experiments/calendar/child/ext-calendar-timezones.js",
        "paths": [["calendar", "timezones"]]
      }
    }
  }
}
