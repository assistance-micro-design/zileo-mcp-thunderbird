{
  "name": "thunderbird-mcp",
  "version": "1.3.1",
  "description": "MCP Server for Thunderbird email client",
  "type": "module",
  "private": true,
  "workspaces": [
    "server",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/assistance-micro-design/thunderbird-mcp"
  },
  "author": "Assistance Micro Design",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "overrides": {
    "hono": ">=4.12.18",
    "@hono/node-server": ">=1.19.14",
    "fast-uri": ">=3.1.2",
    "ip-address": ">=10.2.0",
    "express-rate-limit": ">=8.5.2"
  }
}
