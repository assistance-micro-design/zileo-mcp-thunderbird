{
  "name": "zileo-mcp-thunderbird",
  "version": "1.4.0",
  "description": "MCP Server for Thunderbird email client",
  "type": "module",
  "private": true,
  "workspaces": [
    "server",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=server",
    "package:extension": "npm run package --workspace=extension"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/assistance-micro-design/zileo-mcp-thunderbird"
  },
  "author": "Assistance Micro Design",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.54.0"
  },
  "overrides": {
    "hono": ">=4.12.18",
    "@hono/node-server": ">=1.19.14",
    "fast-uri": ">=3.1.2",
    "ip-address": ">=10.2.0",
    "express-rate-limit": ">=8.5.2",
    "ajv-formats": ">=3.0.1"
  },
  "keywords": [
    "thunderbird",
    "mcp",
    "model-context-protocol",
    "email",
    "ai-assistant",
    "webextension"
  ],
  "homepage": "https://github.com/assistance-micro-design/zileo-mcp-thunderbird#readme",
  "bugs": {
    "url": "https://github.com/assistance-micro-design/zileo-mcp-thunderbird/issues"
  }
}
